{
  "name": "miso-lynx",
  "version": "0.0.1",
  "description": "miso-lynx: A tasty Haskell mobile framework",
  "scripts": {
    "clean": "tsc --build --clean && find ts -name '*~' -or -name '*.js' -delete",
    "watch": "tsc --project tsconfig.lib.json --watch",
    "build": "bun build --outfile=js/miso-lynx.js ./ts/miso-lynx.ts --target=browser --minify-whitespace",
    "js": "bun run build",
    "bundle": "rspeedy build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/haskell-miso/miso-lynx.git"
  },
  "keywords": [
    "miso",
    "virtual-dom",
    "haskell"
  ],
  "author": "dmijo",
  "license": "BSD-3-Clause",
  "bugs": {
    "url": "https://github.com/haskell-miso/miso-lynx/issues"
  },
  "prettier": {
    "singleQuote": true,
    "printWidth": 100,
    "quoteProps": "preserve"
  },
  "homepage": "https://haskell-miso.org",
  "devDependencies": {
    "@happy-dom/global-registrator": "^17.6.3",
    "@types/bun": "latest",
    "prettier": "3.5.3"
  },
  "main": "./js/miso-lynx.js",
  "module": "./ts/miso-lynx.ts",
  "types": "./ts/miso-lynx.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./ts/miso-lynx.ts",
        "default": "./ts/miso-lynx.ts"
      },
      "require": {
        "types": "./ts/miso-lynx.ts",
        "default": "./js/miso-lynx.js"
      },
      "default": "./ts/miso-lynx.ts"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "./ts/miso-lynx.ts",
    "./ts/bts/context.ts",
    "./ts/mts/context.ts",
    "./ts/bts.ts",
    "./ts/mts.ts",
    "package.json",
    "README.md"
  ],
  "dependencies": {
    "@lynx-js/react": "latest",
    "@lynx-js/qrcode-rsbuild-plugin": "latest",
    "@lynx-js/react-alias-rsbuild-plugin": "latest",
    "@lynx-js/react-rsbuild-plugin": "latest",
    "@lynx-js/rspeedy": "latest",
    "@lynx-js/type-element-api": "latest",
    "@lynx-js/types": "latest",
    "@rspack/cli": "latest",
    "@rspack/core": "latest",
    "haskell-miso": "latest",
    "jsbi": "^4.3.2",
    "text-encoding": "^0.7.0",
    "typescript": "^5.9.3"
  }
}
